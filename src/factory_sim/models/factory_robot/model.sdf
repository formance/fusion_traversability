              <max_angle>1.0454522219446034</max_angle>
            </horizontal>
            <vertical>
              <samples>260</samples>
              <resolution>1</resolution>
              <min_angle>-0.2181661564992912</min_angle>
              <max_angle>0.2181661564992912</max_angle>
            </vertical>
          </scan>
          <range>
            <min>1.0</min>
            <max>120.0</max>
            <resolution>0.01</resolution>
          </range>
